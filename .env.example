# Copy to .env and fill in. .env is git-ignored; this file is not.
#
# ONE key belongs here. The advice pane, the EQ chat and the timeline
# commentary call OpenRouter. Everything else in this repo -- measurement,
# mastering, the maximizer, the meters -- is ffmpeg and arithmetic, needs no
# key, and works fully without this file.
#
# The environment wins over the file, so `export OPENROUTER_API_KEY=...`
# overrides it and CI never needs anything on disk. MUSIC_STUDIO_ENV points
# at the file if it lives somewhere other than beside the code.

OPENROUTER_API_KEY=sk-or-v1-...
